# Firebase Google sign-in: TravelConnect's public Web app configuration is
# already bundled in server/firebase-public-config.mjs (travelconnect-f359e).
# An older local .env with mismatched TC_FIREBASE_* entries is ignored by default.
# Only when switching to another project, uncomment all of the following and
# explicitly enable TC_FIREBASE_USE_ENV=1.
# TC_FIREBASE_USE_ENV=1
# TC_FIREBASE_PROJECT_ID=
# TC_FIREBASE_API_KEY=
# TC_FIREBASE_AUTH_DOMAIN=
# TC_FIREBASE_APP_ID=
# TC_FIREBASE_MESSAGING_SENDER_ID=

# FREE TripAI (default): no API key, credits or per-request charges.
# Install Ollama (https://ollama.com/download/mac) and run: ollama pull qwen3:1.7b
TC_AI_PROVIDER=ollama
TC_OLLAMA_MODEL=qwen3:1.7b

# ALTERNATIVE for online hosting: Gemini's limited FREE API tier.
# Obtain a key at https://aistudio.google.com/apikey and switch provider to gemini.
# TC_AI_PROVIDER=gemini
TC_GEMINI_API_KEY=
TC_GEMINI_MODEL=gemini-2.5-flash-lite

# Legacy OPTIONAL paid OpenAI provider, not used unless TC_AI_PROVIDER=openai.
# TC_AI_PROVIDER=openai
TC_OPENAI_API_KEY=
TC_AI_MODEL=gpt-5.4-mini

# Persistent database storage for server deployments only:
# TC_DATA_DIR=/var/lib/travelconnect
